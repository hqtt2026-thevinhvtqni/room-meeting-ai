# ============================================================
# ROOM HOP - Git Ignore Policy
# Source code, tests, docs and canonical fixtures belong in Git.
# Runtime data, generated artifacts and large test data do not.
# ============================================================

# ----------------------------
# Secrets
# ----------------------------
.env
*.env
!.env.example

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
venv/
.venv/

# ----------------------------
# OS / editor
# ----------------------------
.DS_Store
.vscode/
*.log

# ----------------------------
# Runtime / temporary data
# ----------------------------
tmp/
trash/

# Meeting runtime data
meetings/*/*transcript*.txt
meetings/*/secretary*.md
meetings/*/artifacts/
meetings/*/evidence/
meetings/*/audio/

# ----------------------------
# Large / generated test data
# ----------------------------
secretary_size_tests/transcript_*.txt
test_long_transcript.txt
transcript_test_output.txt

# ----------------------------
# Generated test outputs
# ----------------------------
pytest_output.txt
desktop.ini
