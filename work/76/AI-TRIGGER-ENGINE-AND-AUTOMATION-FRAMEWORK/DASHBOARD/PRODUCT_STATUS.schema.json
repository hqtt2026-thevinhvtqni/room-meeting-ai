{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work 76 Product Status — Dashboard v0.2",
  "type": "object",
  "required": [
    "work_id",
    "product_name",
    "work_status",
    "current_phase",
    "source_mode",
    "phases",
    "work_packages",
    "blockers",
    "release_status",
    "freshness",
    "revision",
    "ai_assignments",
    "recent_activity",
    "evidence"
  ],
  "properties": {
    "work_id": {
      "const": "76"
    },
    "product_name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "work_status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "BLOCKED",
        "DONE",
        "NOT_RELEASED"
      ]
    },
    "current_phase": {
      "enum": [
        "01_DISCOVER",
        "02_DEFINE",
        "03_ARCHITECT",
        "04_PLAN",
        "05_BUILD",
        "06_VERIFY",
        "07_ACCEPT",
        "08_RELEASE",
        "09_OPERATE"
      ]
    },
    "source_mode": {
      "enum": [
        "local_snapshot",
        "core_cached",
        "core_live",
        "sample"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "status",
          "gate_status"
        ],
        "properties": {
          "phase_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "gate_status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "wp_id",
          "title",
          "status"
        ],
        "properties": {
          "wp_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "detail_vi": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "mitigation_vi": {
            "type": "string"
          }
        }
      }
    },
    "decisions_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "release_status": {
      "enum": [
        "NOT_RELEASED",
        "RELEASED",
        "ROLLBACK",
        "UNKNOWN"
      ]
    },
    "freshness": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "ai_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ai_id",
          "name",
          "role",
          "assignment_status"
        ],
        "properties": {
          "ai_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "assignment_status": {
            "type": "string"
          }
        }
      }
    },
    "recent_activity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "actor",
          "title",
          "status"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "title",
          "claim",
          "path",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
