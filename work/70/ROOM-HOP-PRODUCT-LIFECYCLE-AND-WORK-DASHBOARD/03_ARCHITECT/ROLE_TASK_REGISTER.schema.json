{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work 70 Role-based Task Register",
  "type": "object",
  "required": [
    "work_id",
    "document_id",
    "schema_version",
    "baseline_status",
    "roles",
    "status_model",
    "tasks",
    "task_count"
  ],
  "properties": {
    "work_id": {
      "const": "70"
    },
    "work_name": {
      "type": "string"
    },
    "document_id": {
      "const": "DOC-093"
    },
    "title": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.1-detailed-task-contract"
    },
    "baseline_status": {
      "enum": [
        "DRAFT_NOT_APPROVED",
        "APPROVED",
        "SUPERSEDED"
      ]
    },
    "authority": {
      "type": "string"
    },
    "orchestrator": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "string"
    },
    "derived_views": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "string"
    },
    "lifecycle_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "name"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "object",
      "required": [
        "CEO",
        "CSA",
        "CTO",
        "CODER"
      ],
      "properties": {
        "CEO": {
          "type": "object"
        },
        "CSA": {
          "type": "object"
        },
        "CTO": {
          "type": "object"
        },
        "CODER": {
          "type": "object"
        }
      }
    },
    "status_model": {
      "type": "array",
      "items": {
        "enum": [
          "PLANNED",
          "READY",
          "IN_PROGRESS",
          "BLOCKED",
          "IN_REVIEW",
          "DONE",
          "CANCELLED"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "phase",
          "phase_name",
          "task_title",
          "accountable_role",
          "role_name",
          "assigned_identity",
          "assignment_status",
          "reviewer_role",
          "inputs",
          "deliverable",
          "acceptance_criteria",
          "dependencies",
          "status",
          "progress_percent",
          "evidence_refs",
          "blockers",
          "next_action",
          "status_note",
          "updated_at",
          "execution_steps",
          "scope_boundary",
          "verification_method",
          "evidence_required",
          "completion_rule"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^W70-"
          },
          "phase": {
            "enum": [
              "01_DISCOVER",
              "02_DEFINE",
              "03_ARCHITECT",
              "04_PLAN",
              "05_BUILD",
              "06_VERIFY",
              "07_ACCEPT",
              "08_RELEASE",
              "09_OPERATE"
            ]
          },
          "phase_name": {
            "type": "string"
          },
          "task_title": {
            "type": "string",
            "minLength": 1
          },
          "accountable_role": {
            "enum": [
              "CEO",
              "CSA",
              "CTO",
              "CODER"
            ]
          },
          "role_name": {
            "type": "string"
          },
          "assigned_identity": {
            "type": "string",
            "minLength": 1
          },
          "assignment_status": {
            "enum": [
              "PROPOSED",
              "PROPOSED_NOT_VERIFIED",
              "CONFIRMED",
              "UNASSIGNED"
            ]
          },
          "reviewer_role": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverable": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^W70-"
            }
          },
          "status": {
            "enum": [
              "PLANNED",
              "READY",
              "IN_PROGRESS",
              "BLOCKED",
              "IN_REVIEW",
              "DONE",
              "CANCELLED"
            ]
          },
          "progress_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string"
          },
          "status_note": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "execution_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scope_boundary": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "completion_rule": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false
}