{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://room-hop.local/schemas/ai-capability-registry.schema.json",
  "title": "ROOM-HOP AI Model Capability Registry",
  "description": "Machine-readable registry of evidence-backed AI capabilities. A registry entry is not an authorization to execute tools or actions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "updated_at",
    "source_architecture",
    "registry_status",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "registry_id": {
      "type": "string",
      "const": "ROOM-HOP-AI-CAPABILITY-REGISTRY"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "source_architecture": {
      "type": "string",
      "const": "DOC-086"
    },
    "registry_status": {
      "type": "string",
      "enum": [
        "INITIALIZED_EMPTY",
        "ACTIVE",
        "MAINTENANCE",
        "DEPRECATED"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "technology_family",
        "task",
        "modality_in",
        "modality_out",
        "provider",
        "model_id",
        "model_version",
        "deployment_mode",
        "tool_or_endpoint",
        "capability_status",
        "verification_date",
        "test_method",
        "test_dataset_or_case",
        "result",
        "limitations",
        "latency_cost_resource_notes",
        "security_privacy_constraints",
        "evidence_uri",
        "evidence_hash",
        "reviewer",
        "next_review_date",
        "freshness_status"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^CAP-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "technology_family": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "modality_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modality_out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "deployment_mode": {
          "type": "string",
          "minLength": 1
        },
        "tool_or_endpoint": {
          "type": "string"
        },
        "capability_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "PARTIAL",
            "UNVERIFIED",
            "UNSUPPORTED"
          ]
        },
        "verification_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "test_method": {
          "type": "string",
          "minLength": 1
        },
        "test_dataset_or_case": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latency_cost_resource_notes": {
          "type": "string"
        },
        "security_privacy_constraints": {
          "type": "string",
          "minLength": 1
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "next_review_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "freshness_status": {
          "type": "string",
          "enum": [
            "CURRENT",
            "STALE",
            "UNVERIFIED",
            "DEPRECATED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "capability_status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "capability_status"
            ]
          },
          "then": {
            "properties": {
              "verification_date": {
                "type": "string",
                "format": "date"
              },
              "evidence_uri": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "not": {
                  "const": "UNKNOWN"
                }
              },
              "test_method": {
                "not": {
                  "const": "NOT_RUN"
                }
              },
              "result": {
                "not": {
                  "const": "NOT_RUN"
                }
              }
            }
          }
        }
      ]
    }
  }
}
