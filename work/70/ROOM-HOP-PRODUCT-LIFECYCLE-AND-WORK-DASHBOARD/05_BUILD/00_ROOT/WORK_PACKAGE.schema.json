{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROOM-HOP Work Package",
  "type": "object",
  "required": [
    "wp_id",
    "title",
    "objective",
    "owner",
    "reviewer",
    "build_areas",
    "dependencies",
    "acceptance_criteria",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "wp_id": {
      "type": "string",
      "pattern": "^WP-[0-9]+-[0-9]{2,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "build_areas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "00_ROOT",
          "01_ORIGINAL",
          "02_EXTENSION",
          "03_ARCHITECTURE",
          "04_CODE",
          "05_TEST",
          "06_EVIDENCE",
          "07_RELEASE",
          "10_AI_DEBUG_HANDOFF"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "PLANNED",
        "READY",
        "ACTIVE",
        "IN_PROGRESS",
        "IN_REVIEW",
        "DONE",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "branch": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
