{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:room-hop:work10:p0:acceptance-manifest:v8",
  "title": "Work 10 P0 Acceptance Evidence Manifest v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "profile",
    "test",
    "stimulus",
    "expected",
    "observed",
    "artifacts",
    "verdict",
    "reviewer",
    "recorded_at",
    "run_context"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "work_id": {
      "const": "10"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "os_family",
        "support_status",
        "fixture_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "os_family": {
          "enum": [
            "windows",
            "linux"
          ]
        },
        "support_status": {
          "enum": [
            "SUPPORTED",
            "UNSUPPORTED",
            "BLOCKED"
          ]
        },
        "fixture_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "host_build": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "x86_64",
            "arm64",
            null
          ]
        },
        "fixture_manifest_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "category",
        "review_revision"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^W10-V8-[A-Z0-9-]+$"
        },
        "category": {
          "enum": [
            "OS_PROFILE",
            "HTTP_ABORT",
            "SPAWN",
            "CRASH_RECOVERY",
            "IPC",
            "SERIALIZATION",
            "ACTION",
            "WORKFLOW",
            "SAFETY",
            "RETRY",
            "HASH"
          ]
        },
        "review_revision": {
          "const": "V8"
        }
      }
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "injection_point",
        "description"
      ],
      "properties": {
        "injection_point": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "expected": {
      "$ref": "#/$defs/state"
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "admission",
        "gate",
        "process_state",
        "containment_state",
        "lease_state",
        "owner_state",
        "oracle_evidence"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNSUPPORTED",
            "TERMINATED",
            "REJECTED"
          ]
        },
        "admission": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "gate": {
          "enum": [
            "CLOSED",
            "OPEN",
            "UNKNOWN"
          ]
        },
        "process_state": {
          "enum": [
            "ABSENT",
            "ALIVE",
            "EXITED",
            "UNKNOWN"
          ]
        },
        "containment_state": {
          "enum": [
            "EMPTY",
            "POPULATED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "lease_state": {
          "enum": [
            "RELEASED",
            "HELD",
            "UNKNOWN"
          ]
        },
        "owner_state": {
          "enum": [
            "CURRENT",
            "FENCED",
            "NONE",
            "UNKNOWN"
          ]
        },
        "oracle_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/oracle"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNSUPPORTED"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "runner_id",
        "source_commit",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 16
        },
        "runner_id": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^(?:[a-fA-F0-9]{40}|LOCAL)$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "required": [
        "outcome",
        "admission",
        "gate",
        "process_state",
        "containment_state",
        "lease_state",
        "owner_state"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNSUPPORTED",
            "TERMINATED",
            "REJECTED"
          ]
        },
        "admission": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "gate": {
          "enum": [
            "CLOSED",
            "OPEN",
            "UNKNOWN"
          ]
        },
        "process_state": {
          "enum": [
            "ABSENT",
            "ALIVE",
            "EXITED",
            "UNKNOWN"
          ]
        },
        "containment_state": {
          "enum": [
            "EMPTY",
            "POPULATED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "lease_state": {
          "enum": [
            "RELEASED",
            "HELD",
            "UNKNOWN"
          ]
        },
        "owner_state": {
          "enum": [
            "CURRENT",
            "FENCED",
            "NONE",
            "UNKNOWN"
          ]
        }
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_id",
        "source",
        "result",
        "artifact_ref"
      ],
      "properties": {
        "oracle_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PRESENT",
            "NA"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "na_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PRESENT"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NA"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "na_reason"
            ],
            "properties": {
              "na_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "support_status": {
                "const": "SUPPORTED"
              }
            },
            "required": [
              "support_status"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "required": [
              "host_build",
              "architecture",
              "fixture_manifest_ref"
            ],
            "properties": {
              "fixture_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "host_build": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "enum": [
                  "x86_64",
                  "arm64"
                ]
              },
              "fixture_manifest_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "profile",
          "observed"
        ],
        "properties": {
          "profile": {
            "properties": {
              "support_status": {
                "const": "SUPPORTED"
              }
            }
          },
          "observed": {
            "properties": {
              "admission": {
                "const": "CLOSED"
              },
              "gate": {
                "const": "CLOSED"
              },
              "containment_state": {
                "const": "EMPTY"
              },
              "process_state": {
                "enum": [
                  "ABSENT",
                  "EXITED"
                ]
              },
              "lease_state": {
                "enum": [
                  "RELEASED",
                  "HELD"
                ]
              },
              "owner_state": {
                "enum": [
                  "CURRENT",
                  "FENCED",
                  "NONE"
                ]
              },
              "oracle_evidence": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "support_status": {
                "const": "UNSUPPORTED"
              }
            },
            "required": [
              "support_status"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "verdict": {
            "enum": [
              "BLOCKED",
              "UNSUPPORTED",
              "FAIL"
            ]
          }
        }
      }
    }
  ]
}
